# magic_enum configuration for the Holoscan SDK revendored static library.
# This is a lightweight distribution vendoring only the magic_enum.hpp library header
# and not other utility files that may be available in libmagic_enum-dev packages.

@PACKAGE_INIT@

# Idempotency and conflict checks
if(magic_enum_FOUND)
  check_required_components(magic_enum)
  return()
endif()
# Target may already exist from an earlier find_package at another scope.
# Treat as found so this find_package call succeeds idempotently.
if(TARGET magic_enum::magic_enum)
  set(magic_enum_FOUND TRUE)
  check_required_components(magic_enum)
  return()
endif()

set_and_check(MAGIC_ENUM_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/3rdparty/magic_enum")

set(magic_enum_FOUND TRUE)
add_library(magic_enum::magic_enum INTERFACE IMPORTED)
set_target_properties(magic_enum::magic_enum PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${MAGIC_ENUM_INCLUDE_DIR}"
)

if(NOT magic_enum_FIND_QUIETLY)
  message(STATUS "Found magic_enum: ${CMAKE_CURRENT_LIST_DIR} (found version: \"${magic_enum_VERSION}\")")
endif()

check_required_components(magic_enum)

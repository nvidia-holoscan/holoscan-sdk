# Custom UCX configuration file to enable development with UCX shared libraries
# revendored with the Holoscan SDK binary distribution.
# Based on UCX 1.19.0 ucx-config.cmake

@PACKAGE_INIT@

# Idempotency and conflict checks
if(ucx_FOUND)
  check_required_components(ucx)
  return()
endif()
# Target may already exist from an earlier find_package at another scope.
# Treat as found so this find_package call succeeds idempotently.
if(TARGET ucx::ucp AND TARGET ucx::ucs AND TARGET ucx::uct)
  set(ucx_FOUND TRUE)
  check_required_components(ucx)
  return()
endif()

set_and_check(ucx_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/3rdparty/ucx")

if(NOT TARGET ucx::ucs)
  add_library(ucx::ucs SHARED IMPORTED)

  set_and_check(UCS_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libucs.so")
  set_target_properties(ucx::ucs PROPERTIES
    IMPORTED_LOCATION "${UCS_LOCATION}"
    INTERFACE_INCLUDE_DIRECTORIES "${ucx_INCLUDE_DIR}"
  )
endif()

if(NOT TARGET ucx::ucp)
  add_library(ucx::ucp SHARED IMPORTED)

  set_and_check(UCP_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libucp.so")
  set_target_properties(ucx::ucp PROPERTIES
    IMPORTED_LOCATION "${UCP_LOCATION}"
    INTERFACE_INCLUDE_DIRECTORIES "${ucx_INCLUDE_DIR}"
  )
endif()

if(NOT TARGET ucx::uct)
  add_library(ucx::uct SHARED IMPORTED)

  set_and_check(UCT_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libuct.so")
  set_target_properties(ucx::uct PROPERTIES
    IMPORTED_LOCATION "${UCT_LOCATION}"
    INTERFACE_INCLUDE_DIRECTORIES "${ucx_INCLUDE_DIR}"
  )
endif()

# Match variables from common UCX distributions
set_and_check(UCX_LIBRARIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
set_and_check(UCX_INCLUDE_DIRS "${ucx_INCLUDE_DIR}")

# Report UCX found message unless QUIET is specified
if(NOT ucx_FIND_QUIETLY)
  message(STATUS "Found UCX: ${ucx_DIR} (found version \"${ucx_VERSION}\")")
endif()

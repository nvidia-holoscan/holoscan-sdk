From 1b9963dab4a0946cdb6806f6e98673bcc8a41d5e Mon Sep 17 00:00:00 2001
From: JC Fillion-Robin <jcfr@nvidia.com>
Date: Tue, 18 Aug 2026 01:24:21 -0400
Subject: [PATCH] build: use modern CMake package root behavior

Holoscan configures MatX through CPM and may intentionally provide
uppercase package root variables. Remove the dependency policy override
so CMake CMP0144 NEW behavior honors those caller-provided roots.

Upstream-Status: Backport [https://github.com/NVIDIA/MatX/commit/5eceb9cd938765899795a122819df32c64a9105c]

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8eea93ad..f58427b7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,10 +1,5 @@
 cmake_minimum_required(VERSION 3.30.4)
 
-if(POLICY CMP0144)
-    # Preserve current behavior: CI may export upper-case package root variables
-    # that should not override dependencies fetched through CPM.
-    cmake_policy(SET CMP0144 OLD)
-endif()
 set(MATX_VERSION 1.0.0)
 
 # Used for config file generation

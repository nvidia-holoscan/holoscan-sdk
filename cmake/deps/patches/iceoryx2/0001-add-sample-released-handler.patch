+
+/// Callback invoked when a publisher sample bucket is reclaimed.
+pub trait SampleReleasedFn: Fn(&SampleReleasedInfo) + Send {}
+
+impl<F: Fn(&SampleReleasedInfo) + Send> SampleReleasedFn for F {}

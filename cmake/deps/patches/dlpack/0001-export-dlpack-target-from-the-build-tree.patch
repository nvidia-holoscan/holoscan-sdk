From ec3e01161a493ce1d77bc49df5c58cda5787c766 Mon Sep 17 00:00:00 2001
From: Tom Birdsong <tbirdsong@nvidia.com>
Date: Mon, 2 Mar 2026 08:46:11 -0800
Subject: [PATCH] build: export DLPack target from build tree

Holoscan registers DLPack in its build export set while consuming it as
a subproject. Export the interface target so generated package
configuration can resolve it without relying on install-tree artifacts.

Upstream-Status: Pending [upstream submission not yet prepared]
Co-authored-by: Gigon Bae <gbae@nvidia.com>

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3afca828..367b8a6b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -125,5 +125,10 @@ install(
     NAMESPACE "${namespace}"
     DESTINATION "${config_install_dir}"
 )
+export(
+    TARGETS dlpack
+    NAMESPACE "${namespace}"
+    FILE "${generated_dir}/${TARGETS_EXPORT_NAME}.cmake"
+)
 
 # }

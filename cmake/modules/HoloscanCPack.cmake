endif()
if(HOLOSCAN_BUILD_VISUALIZATION)
  list(APPEND CPACK_COMPONENTS_ALL holoscan-visualization)
  if(TARGET holoscan_visualization_python)
    list(APPEND CPACK_COMPONENTS_ALL holoscan-visualization-python_libs)
  endif()
  if(HOLOSCAN_BUILD_EXAMPLES)
    list(APPEND CPACK_HOLOSCAN_EXAMPLE_COMPONENTS holoscan-visualization-examples)
  endif()

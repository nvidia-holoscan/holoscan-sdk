# CPACK config
set(CPACK_PACKAGE_NAME ${PROJECT_NAME} CACHE STRING "Holoscan SDK")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Holoscan SDK"
    CACHE STRING "Package description for Holoscan SDK"
)
set(CPACK_PACKAGE_VENDOR "NVIDIA")
set(CPACK_PACKAGE_INSTALL_DIRECTORY ${CPACK_PACKAGE_NAME})

set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")

set(CPACK_PACKAGE_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})
set(CPACK_PACKAGE_VERSION_MINOR ${PROJECT_VERSION_MINOR})
set(CPACK_PACKAGE_VERSION_PATCH ${PROJECT_VERSION_PATCH})

set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Julien Jomier")

set(CPACK_RESOURCE_FILE_LICENSE "${holoscan_SOURCE_DIR}/LICENSE.txt")
set(CPACK_RESOURCE_FILE_README "${holoscan_SOURCE_DIR}/README.md")

# Sets the package name as debian format
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA
    "${CMAKE_CURRENT_LIST_DIR}/cpack/triggers")

# Generate the granular package layout by default. Developers can request the historical
# single-package layout at CPack invocation time with
# `-D HOLOSCAN_CPACK_MONOLITHIC_PACKAGE=ON`; see HoloscanCPackProjectConfig.cmake.
set(CPACK_DEB_COMPONENT_INSTALL 1)
set(CPACK_COMPONENTS_GROUPING ONE_PER_GROUP)
set(CPACK_PROJECT_CONFIG_FILE
  "${CMAKE_CURRENT_LIST_DIR}/cpack/HoloscanCPackProjectConfig.cmake")

# List of the components that should be installed
set(CPACK_COMPONENTS_ALL
  holoscan # component from rapids-cmake export
  holoscan-core
  holoscan-config
  holoscan-config-io
  # Sensor acquisition support. Exported through the shared holoscan-exports set (a Core prefix
  # requires it) but attributed to its own install component for packaging granularity.
  holoscan-sensor-io
  holoscan-holomq
  holoscan-benchmarks
  holoscan-dependencies
  # iceoryx2-cxx installs its package configuration and headers in the upstream `dev` component,
  # while its targets and libraries use `holoscan-dependencies` and `iceoryx2-lib`. Include it so
  # a CPack-installed core prefix remains consumable through find_package(holoscan).
  dev
  holoscan-python_libs
  holoscan-sensor-io-python_libs
  holoscan-cpack
  # Archive-root license copy; Debian packages ship it under share/doc instead.
  holoscan-archive-license
  # iceoryx2 component holding its C++ and Rust FFI libraries. Upstream names it 'lib'; the
  # SDK renames it in cmake/deps/patches/iceoryx2/0004-name-library-install-component.patch.
  iceoryx2-lib
)

# Graph artifacts are generated by executing an application in its explicit
# artifact-only mode. Keep that optional install component out of the default
# SDK package so package construction does not acquire the application's
# runtime-only dependencies (for example, a CUDA driver). Developers can still
# request it directly with
# `cmake --install <build-directory> --component holoscan-graph-artifacts`.

# Examples are installed by `cmake --install` but are not packaged by default. Their components are
# recorded for packages that opt in with `cpack -D HOLOSCAN_CPACK_INCLUDE_EXAMPLES=ON`.
set(CPACK_HOLOSCAN_EXAMPLE_COMPONENTS)
if(HOLOSCAN_BUILD_EXAMPLES)
  list(APPEND CPACK_HOLOSCAN_EXAMPLE_COMPONENTS holoscan-core-examples)
endif()

if(HOLOSCAN_BUILD_TESTING_LIBRARY)
  # Preserve focused CMake component installs while packaging all non-module payload in Core.
  list(APPEND CPACK_COMPONENTS_ALL holoscan-testing)
  if(TARGET holoscan_testing_python)
    list(APPEND CPACK_COMPONENTS_ALL holoscan-testing-python_libs)
  endif()
  if(HOLOSCAN_BUILD_EXAMPLES)
    list(APPEND CPACK_HOLOSCAN_EXAMPLE_COMPONENTS holoscan-testing-examples)
  endif()
endif()
if(HOLOSCAN_BUILD_EXPERIMENTAL_PARAMS_WEB_TUNER)
  list(APPEND CPACK_COMPONENTS_ALL holoscan-experimental-params-web-tuner)
endif()
if(HOLOSCAN_BUILD_INFERENCE)
  list(APPEND CPACK_COMPONENTS_ALL holoscan-inference)
  if(TARGET holoscan_inference_python)
    list(APPEND CPACK_COMPONENTS_ALL holoscan-inference-python_libs)
  endif()
  if(HOLOSCAN_BUILD_EXAMPLES)
    list(APPEND CPACK_HOLOSCAN_EXAMPLE_COMPONENTS holoscan-inference-examples)
  endif()
endif()
if(HOLOSCAN_BUILD_VISION)
  include("${holoscan_SOURCE_DIR}/modules/vision/cmake/CVCUDAVersion.cmake")
  if(NOT TARGET vision)
    message(FATAL_ERROR
      "HOLOSCAN_BUILD_VISION is ON, but target 'vision' was not created; "
      "cannot configure the holoscan-vision package"
    )
  endif()
  list(APPEND CPACK_COMPONENTS_ALL holoscan-vision)
  if(TARGET holoscan_vision_python)
    list(APPEND CPACK_COMPONENTS_ALL holoscan-vision-python_libs)

# Debian package relations, one list entry per relation. CUDA entries name capabilities that every
# CUDA 13 minor release provides.
set(_holoscan_core_depends)
set(_holoscan_vision_depends)
set(_holoscan_inference_depends)
set(_holoscan_visualization_depends)
set(_holoscan_visualization_recommends)

# - cuda-nvcc: needed to find Holoscan with CMake (FindCUDAToolkit requirement); not needed at
#   runtime.
list(APPEND _holoscan_core_depends "cuda-nvcc-13")
# - cuda-cudart-dev: needed for downstream CUDAToolkit development.
list(APPEND _holoscan_core_depends "libcudart.so.13-dev")
list(APPEND _holoscan_core_depends "libexpected-dev (>= 1.1.0)")

if(HOLOSCAN_BUILD_VISION)
  # BayerDemosaicOp requires NPP. Shared Vision links CUDA::nppicc; static Vision exports
  # CUDA::nppicc_static, so downstream applications need the NPP development archives.
  # Depend on the NPP library capabilities rather than CUDA-minor-specific package names
  # (e.g. libnpp-13-0), which differ between CUDA, JetPack, and IGX APT repositories.
  if(BUILD_SHARED_LIBS)
    list(APPEND _holoscan_vision_depends "libnpp.so.13")
  else()
    list(APPEND _holoscan_vision_depends "libnpp.so.13-dev")
    # Static SDK consumers need CV-CUDA's development files. Users install the matching
    # GitHub release Debian packages manually; an APT repository is not required to satisfy
    # this dependency. Published shared SDK packages bundle the CV-CUDA runtime instead.
    list(APPEND _holoscan_vision_depends
      "cvcuda0-dev (>= ${HOLOSCAN_VISION_CVCUDA_VERSION_MIN})"
      "cvcuda0-dev (<< ${HOLOSCAN_VISION_CVCUDA_VERSION_MAX})")
  endif()
endif()

if(HOLOSCAN_BUILD_INFERENCE)
  # - libnvrtc dev: holoinfer_utils publicly links CUDA::nvrtc, so downstream CMake consumers need
  #   the NVRTC development files.
  list(APPEND _holoscan_inference_depends "libnvrtc.so.13-dev")
  # - NPP: TensorPreprocessorOp links the NPP libraries; static consumers need the development
  #   files to link them.
  if(BUILD_SHARED_LIBS)
    list(APPEND _holoscan_inference_depends "libnpp.so.13")
  else()
    list(APPEND _holoscan_inference_depends "libnpp.so.13-dev")
  endif()
  # - TensorRT 10 runtime libraries: match the SONAMEs linked by this SDK; the unversioned
  #   tensorrt-libs meta-package may select TensorRT 11.
  list(APPEND _holoscan_inference_depends
    "libnvinfer10 (>= 10.13)"
    "libnvinfer-plugin10 (>= 10.13)"
    "libnvonnxparsers10 (>= 10.13)")
endif()

if(HOLOSCAN_BUILD_VISUALIZATION)
  # - libvulkan1: Holoviz loads Vulkan at runtime.
  list(APPEND _holoscan_visualization_depends "libvulkan1")
  # - Windowing libraries: only needed for on-screen display.
  list(APPEND _holoscan_visualization_recommends libdrm2 libegl1 libx11-6 libxrandr2)
endif()

# The global relation lists describe the monolithic package, which contains every component.
set(_holoscan_all_depends
  ${_holoscan_core_depends}
  ${_holoscan_vision_depends}
  ${_holoscan_inference_depends}
  ${_holoscan_visualization_depends})
list(REMOVE_DUPLICATES _holoscan_all_depends)
list(JOIN _holoscan_all_depends ", " CPACK_DEBIAN_PACKAGE_DEPENDS)
list(JOIN _holoscan_visualization_recommends ", " CPACK_DEBIAN_PACKAGE_RECOMMENDS)
unset(_holoscan_all_depends)

# In granular mode each component group becomes one payload package. Defining every group-level
# dependency variable prevents CPack from copying the monolithic dependency list to module packages.
set(CPACK_DEBIAN_CORE_PACKAGE_NAME holoscan-core)
set(CPACK_DEBIAN_VISION_PACKAGE_NAME holoscan-vision)
set(CPACK_DEBIAN_INFERENCE_PACKAGE_NAME holoscan-inference)
set(CPACK_DEBIAN_VISUALIZATION_PACKAGE_NAME holoscan-visualization)
foreach(group IN ITEMS CORE VISION INFERENCE VISUALIZATION)
  string(TOLOWER "${group}" _holoscan_group)
  list(JOIN _holoscan_${_holoscan_group}_depends ", " CPACK_DEBIAN_${group}_PACKAGE_DEPENDS)
  unset(_holoscan_${_holoscan_group}_depends)
endforeach()
unset(_holoscan_group)
list(JOIN _holoscan_visualization_recommends ", " CPACK_DEBIAN_VISUALIZATION_PACKAGE_RECOMMENDS)
unset(_holoscan_visualization_recommends)

include(CPackComponent)

cpack_add_component_group(core DESCRIPTION "Holoscan SDK core and developer payload")
cpack_add_component_group(vision DESCRIPTION "Holoscan Vision module")
cpack_add_component_group(inference DESCRIPTION "Holoscan Inference module")
cpack_add_component_group(visualization DESCRIPTION "Holoscan Visualization module")

# Add the components to packages
message(STATUS "Components to pack: ${CPACK_COMPONENTS_ALL}")
if(CPACK_HOLOSCAN_EXAMPLE_COMPONENTS)
  message(STATUS "Opt-in example components to pack: ${CPACK_HOLOSCAN_EXAMPLE_COMPONENTS}")
endif()
foreach(component IN LISTS CPACK_COMPONENTS_ALL CPACK_HOLOSCAN_EXAMPLE_COMPONENTS)
  if(component STREQUAL "holoscan-vision" OR component STREQUAL "holoscan-vision-examples"
      OR component STREQUAL "holoscan-vision-python_libs")
    cpack_add_component(${component} GROUP vision DEPENDS holoscan-core)
  elseif(component STREQUAL "holoscan-inference"
      OR component STREQUAL "holoscan-inference-examples"
      OR component STREQUAL "holoscan-inference-python_libs")
    cpack_add_component(${component} GROUP inference DEPENDS holoscan-core)
  elseif(component STREQUAL "holoscan-visualization"
      OR component STREQUAL "holoscan-visualization-examples"
      OR component STREQUAL "holoscan-visualization-python_libs")
    cpack_add_component(${component} GROUP visualization DEPENDS holoscan-core)
  else()
    cpack_add_component(${component} GROUP core)
  endif()
endforeach()

include(CPack)

include "tensor.fbs";

namespace python.fixture;

table FrameHeader {
  sequence: ulong (id: 0);
  source: string (id: 1);
}

table StereoPayload {
  header: FrameHeader (id: 0);
  left: holoscan.schema.Tensor (id: 1);
  right: holoscan.schema.Tensor (id: 2);
  exposure_us: uint (id: 3);
}

root_type StereoPayload;
file_identifier "PYSP";

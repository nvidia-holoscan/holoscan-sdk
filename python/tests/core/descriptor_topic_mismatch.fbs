include "tensor.fbs";

namespace tensor_topic;

// Same schema identity as the fixture payload, but a deliberately incompatible Tensor inventory.
table ExternalFrame {
  sequence: ulong (id: 0);
  source: string (id: 1);
  pixels: holoscan.schema.Tensor (id: 2);
  calibration: holoscan.schema.Tensor (id: 3);
  auxiliary: holoscan.schema.Tensor (id: 4);
}

root_type ExternalFrame;
file_identifier "AEFR";

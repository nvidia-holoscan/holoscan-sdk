# fmt: off

"""Explicit temporal units used by Holoscan authoring APIs."""



class Duration:
    @property
    def nanoseconds(self) -> int: ...

    def __repr__(self) -> str: ...

class TimePoint:
    def __init__(self, timestamp_ns: int, clock_id: int) -> None: ...

    @property
    def timestamp_ns(self) -> int: ...

    @property
    def clock_id(self) -> int: ...

    @property
    def valid(self) -> bool: ...

    def __eq__(self, arg0: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...

class TagTime:
    def __init__(self, logical_ns: int, microstep: int = 0) -> None: ...

    @property
    def logical_ns(self) -> int: ...

    @property
    def microstep(self) -> int: ...

    @property
    def valid(self) -> bool: ...

    def __eq__(self, arg0: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...

def ns(value: int) -> Duration: ...

def us(value: int) -> Duration: ...

def ms(value: int) -> Duration: ...

__all__: list[str] = ['Duration', 'TimePoint', 'TagTime', 'ns', 'us', 'ms']

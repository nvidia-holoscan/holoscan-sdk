if(NOT COMMAND holoscan_add_dependency)
    return()
endif()

list(APPEND CMAKE_MESSAGE_CONTEXT "example_deps")

set(_HOLOSCAN_EXAMPLE_DEPS_SAVED_CMAKE_IGNORE_PREFIX_PATH "${CMAKE_IGNORE_PREFIX_PATH}")
list(APPEND CMAKE_IGNORE_PREFIX_PATH "${holoscan_BINARY_DIR}")

rapids_cpm_init()

set(_HOLOSCAN_EXAMPLE_DEPS_SAVED_CMAKE_CXX_CLANG_TIDY "${CMAKE_CXX_CLANG_TIDY}")
set(CMAKE_CXX_CLANG_TIDY "")

holoscan_add_dependency(cccl COMPONENT holoscan-dependencies)
holoscan_add_dependency(matx COMPONENT holoscan-dependencies)

set(CMAKE_CXX_CLANG_TIDY "${_HOLOSCAN_EXAMPLE_DEPS_SAVED_CMAKE_CXX_CLANG_TIDY}")
unset(_HOLOSCAN_EXAMPLE_DEPS_SAVED_CMAKE_CXX_CLANG_TIDY)

set(CMAKE_IGNORE_PREFIX_PATH "${_HOLOSCAN_EXAMPLE_DEPS_SAVED_CMAKE_IGNORE_PREFIX_PATH}")
unset(_HOLOSCAN_EXAMPLE_DEPS_SAVED_CMAKE_IGNORE_PREFIX_PATH)

list(POP_BACK CMAKE_MESSAGE_CONTEXT)

include "tensor.fbs";
namespace fixture_example;
table FrameHeader {
  sequence: ulong (id: 0);
  source: string (id: 1);
}
table PairedFrame {
  header: FrameHeader (id: 0);
  first: holoscan.schema.Tensor (id: 1);
  second: holoscan.schema.Tensor (id: 2);
}
root_type PairedFrame;
file_identifier "OTPF";

// App-level DDS buffer types (multiple structs in one IDL file).
// AccelBuffer: device/accelerated memory via IPC PointerDescriptor + logical size + publisher sample index.
// Buffer: host-side payload as raw bytes (no PointerDescriptor) + sample index for future use.

#include "pointer_descriptor.idl"

module holoscan
{
    module ipc
    {
        module fastdds_benchmark
        {
            struct AccelBuffer
            {
                holoscan::ipc::PointerDescriptor descriptor;
                unsigned long size;
                unsigned long index;
            };

            struct Buffer
            {
                sequence<octet> data;
                unsigned long index;
            };
        };
    };
};

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Core's export set carries holoscan::sensor_io, which op_holoviz links PUBLIC for its
# Input<schema::ImageT> layer ports, so holoscan-visualization-targets.cmake resolves below.
find_dependency(holoscan @PROJECT_VERSION@ CONFIG REQUIRED COMPONENTS core)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-visualization-targets.cmake")
# The build-time shader compilation helper (holoviz_generate_shader_header) ships with this
# component beside this file.
include("${CMAKE_CURRENT_LIST_DIR}/HolovizShaderHeader.cmake")
check_required_components(holoscan-visualization)

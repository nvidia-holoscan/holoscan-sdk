# Build-time Slang shader compilation.
#
# holoviz_generate_shader_header(
#     OUTPUT <file.slang.hpp>        # absolute path of the generated header
#     SLANG <file.slang>             # relative to CMAKE_CURRENT_SOURCE_DIR
#     [NAMESPACE <ns>]               # default: holoviz::<slang file stem>
#     [SLANGC <slangc>]              # explicit compiler; see resolution below
#     PAIRS <name=vs_entry:fs_entry> [...]
#     [INCLUDE_DIRS <dir> [...]]     # extra #include search paths for the shader
#     [PUSH_CONSTANTS_TYPE <cpp type>          # shared push-constant struct, see below
#      PUSH_CONSTANTS_INCLUDE <header>]
# )
#
# Declares a custom command that runs holoviz_shader_compiler.py on the .slang
# source and writes OUTPUT (embedded SPIR-V + a make_shader_blob() factory per
# pair). Regenerates whenever the .slang file, anything it #includes (tracked
# through a slangc depfile), the compiler script, or the slangc executable changes.
#
# Shared interface headers: a shader may #include a header that is also valid
# C++ (built on <holoviz/shader_interop.hpp>) so its push-constant struct and
# shared constants have a single definition. The HoloViz public include
# directory and the shader's own directory are always on the include path;
# INCLUDE_DIRS adds more. PUSH_CONSTANTS_TYPE names the fully qualified C++
# struct the shader's push-constant block is declared with and
# PUSH_CONSTANTS_INCLUDE the interface header as the consuming C++ includes it;
# the generated header then #includes it and static_asserts the struct's size and
# every field offset against the reflected layout, so the two languages cannot
# drift apart silently.
#
# This helper only generates; consumers attach the header themselves via
# target_sources() and add the directory containing OUTPUT (typically a shared
# <binary dir>/holoviz_generated root, so `#include "backends/rhi_image.slang.hpp"`
# style paths work) to their include paths. An add_custom_command(OUTPUT) only
# wires automatically into targets created in the same directory; a consumer
# created in another scope (e.g. the holoviz target itself) additionally needs a
# named custom target over the generated headers plus add_dependencies() so
# generation always precedes its object compiles.
#
# The compiler script is located beside this file. Both are installed together
# under <prefix>/lib/cmake/holoscan and included by holoscan-config.cmake, so an
# installed Holoscan SDK offers the same function to downstream projects.
#
# slangc resolution, first match wins:
#   1. the SLANGC argument;
#   2. the HOLOVIZ_SLANGC_EXECUTABLE global property recorded by the SDK's Slang
#      dependency recipe (cmake/deps/slang.cmake), which has already probed it;
#   3. the HOLOVIZ_SLANGC cache variable;
#   4. find_program(slangc) over CMAKE_PREFIX_PATH and the PATH.
# Downstream projects therefore only need a slangc on hand; they never run the
# SDK's dependency recipe.

include_guard(GLOBAL)

function(holoviz_generate_shader_header)
  set(_options)
  set(_single_args OUTPUT SLANG NAMESPACE SLANGC PUSH_CONSTANTS_TYPE PUSH_CONSTANTS_INCLUDE)
  set(_multi_args PAIRS INCLUDE_DIRS)
  cmake_parse_arguments(_hsh "${_options}" "${_single_args}" "${_multi_args}" ${ARGN})

  if(NOT _hsh_OUTPUT OR NOT _hsh_SLANG OR NOT _hsh_PAIRS)
    message(FATAL_ERROR
      "holoviz_generate_shader_header(): OUTPUT, SLANG and PAIRS are required")
  endif()
  if(_hsh_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR
      "holoviz_generate_shader_header(): unknown arguments ${_hsh_UNPARSED_ARGUMENTS}")
  endif()
  if((_hsh_PUSH_CONSTANTS_TYPE AND NOT _hsh_PUSH_CONSTANTS_INCLUDE) OR
     (_hsh_PUSH_CONSTANTS_INCLUDE AND NOT _hsh_PUSH_CONSTANTS_TYPE))
    message(FATAL_ERROR
      "holoviz_generate_shader_header(): PUSH_CONSTANTS_TYPE and PUSH_CONSTANTS_INCLUDE go "
      "together")
  endif()

  # Shader headers are generated by a Python tool; the interpreter is a hard
  # build dependency. The top-level SDK find is QUIET and unversioned, and
  # standalone module configures skip it entirely, so resolve it here.
  # Any interpreter >= 3.10 is accepted.
  find_package(Python3 3.10 COMPONENTS Interpreter QUIET)
  if(NOT Python3_Interpreter_FOUND)
    message(FATAL_ERROR
      "holoviz_generate_shader_header(): a Python interpreter >= 3.10 is required to "
      "compile Slang shaders at build time; install python3 or point "
      "Python3_EXECUTABLE at an interpreter")
  endif()

  set(_hsh_tool "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/holoviz_shader_compiler.py")
  if(NOT EXISTS "${_hsh_tool}")
    message(FATAL_ERROR
      "Incomplete HoloViz shader tooling installation: ${_hsh_tool} is missing "
      "(expected it to be installed beside HolovizShaderHeader.cmake)")
  endif()

  set(_hsh_slangc "${_hsh_SLANGC}")
  if(NOT _hsh_slangc)
    get_property(_hsh_slangc GLOBAL PROPERTY HOLOVIZ_SLANGC_EXECUTABLE)
  endif()
  if(NOT _hsh_slangc)
    set(_hsh_slangc "${HOLOVIZ_SLANGC}")
  endif()
  if(NOT _hsh_slangc)
    # A scratch cache entry: the search re-runs on every configure and every call instead of
    # pinning the first result.
    unset(_hsh_slangc_found CACHE)
    find_program(_hsh_slangc_found slangc)
    set(_hsh_slangc "${_hsh_slangc_found}")
    unset(_hsh_slangc_found CACHE)
  endif()
  if(NOT _hsh_slangc)
    message(FATAL_ERROR
      "holoviz_generate_shader_header(): no slangc available; pass SLANGC <path>, set "
      "HOLOVIZ_SLANGC, or add slangc to CMAKE_PREFIX_PATH or PATH")
  endif()

  set(_hsh_source "${CMAKE_CURRENT_SOURCE_DIR}/${_hsh_SLANG}")
  set(_hsh_depfile "${_hsh_OUTPUT}.d")

  # <holoviz/shader_interop.hpp> must resolve from the shader. The SDK build aliases its holoviz
  # target under the exported name, so the same target answers in the build tree and for a
  # downstream project's imported target. Evaluated at generate time.
  if(NOT TARGET holoscan::visualization::holoviz)
    message(FATAL_ERROR
      "holoviz_generate_shader_header(): holoscan::visualization::holoviz is not a target; call "
      "this after the HoloViz library is defined or imported")
  endif()
  set(_hsh_holoviz_includes
    "$<TARGET_PROPERTY:holoscan::visualization::holoviz,INTERFACE_INCLUDE_DIRECTORIES>")
  get_filename_component(_hsh_source_dir "${_hsh_source}" DIRECTORY)

  set(_hsh_args
    "${_hsh_tool}"
    --slangc "${_hsh_slangc}"
    --input "${_hsh_source}"
    --emit-header "${_hsh_OUTPUT}"
    --emit-depfile "${_hsh_depfile}"
    --include-dir "${_hsh_source_dir}"
    # One --include-dir per directory of the list-valued property. $<INSTALL_INTERFACE:...>
    # entries evaluate to empty strings here and are filtered out first, so no --include-dir is
    # left without a value.
    "$<LIST:TRANSFORM,$<FILTER:${_hsh_holoviz_includes},EXCLUDE,^$>,PREPEND,--include-dir$<SEMICOLON>>"
  )
  foreach(_hsh_include_dir IN LISTS _hsh_INCLUDE_DIRS)
    list(APPEND _hsh_args --include-dir "${_hsh_include_dir}")
  endforeach()
  if(_hsh_NAMESPACE)
    list(APPEND _hsh_args --namespace "${_hsh_NAMESPACE}")
  endif()
  foreach(_hsh_pair IN LISTS _hsh_PAIRS)
    list(APPEND _hsh_args --pair "${_hsh_pair}")
  endforeach()
  if(_hsh_PUSH_CONSTANTS_TYPE)
    list(APPEND _hsh_args
      --push-constants-type "${_hsh_PUSH_CONSTANTS_TYPE}"
      --push-constants-include "${_hsh_PUSH_CONSTANTS_INCLUDE}")
  endif()

  # DEPFILE makes every header the shader #included a prerequisite (CMP0116 is NEW under the
  # module's cmake_minimum_required, so the paths need no build-directory rewriting).
  add_custom_command(
    OUTPUT "${_hsh_OUTPUT}"
    COMMAND ${Python3_EXECUTABLE} ${_hsh_args}
    MAIN_DEPENDENCY "${_hsh_source}"
    DEPENDS "${_hsh_tool}" "${_hsh_slangc}"
    DEPFILE "${_hsh_depfile}"
    COMMENT "Compiling Slang shader ${_hsh_SLANG} -> ${_hsh_SLANG}.hpp"
    COMMAND_EXPAND_LISTS
    VERBATIM
  )
endfunction()

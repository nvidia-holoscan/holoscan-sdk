@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(holoscan @PROJECT_VERSION@ CONFIG REQUIRED COMPONENTS core)

if(NOT @BUILD_SHARED_LIBS@)
    set(_holoscan_inference_private_archive
        "${PACKAGE_PREFIX_DIR}/@HOLOSCAN_INSTALL_LIB_DIR@/@CMAKE_STATIC_LIBRARY_PREFIX@holoscan_inference_yaml_private@CMAKE_STATIC_LIBRARY_SUFFIX@")
    if(NOT EXISTS "${_holoscan_inference_private_archive}")
        set(holoscan-inference_FOUND FALSE)
        return()
    endif()
    if(NOT TARGET holoscan::_inference_yaml_private)
        add_library(holoscan::_inference_yaml_private STATIC IMPORTED)
        set_target_properties(holoscan::_inference_yaml_private PROPERTIES
            IMPORTED_LOCATION "${_holoscan_inference_private_archive}"
        )
    endif()
    unset(_holoscan_inference_private_archive)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-inference-targets.cmake")
check_required_components(holoscan-inference)

include "tensor.fbs";

namespace holoscan.schema;

// SDK convenience schema for one descriptor-backed Tensor with common application metadata.
table TensorPacket {
  sequence: ulong (id: 0);
  source: string (id: 1);
  scale: double = 1.0 (id: 2);
  data: Tensor (id: 3);
}

root_type TensorPacket;
file_identifier "HSTP";

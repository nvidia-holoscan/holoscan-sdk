include "header.fbs";

namespace holoscan.schema;

// Fixed-size quaternion kept inline (no Tensor sidecar/lifetime machinery) for the small
// orientation value.
struct Quaternionf {
  w: float;
  x: float;
  y: float;
  z: float;
}

// Fixed-size vector kept inline (avoids pulling in Eigen/math_types for the IMU schema).
struct Vector3f {
  x: float;
  y: float;
  z: float;
}

// Inertial measurement unit message.
table Imu {
  // Header (frame and timestamps).
  header: Header (id: 0);

  // Inline orientation quaternion.
  orientation: Quaternionf (id: 1, native_inline);

  // Inline angular velocity vector.
  angular_velocity: Vector3f (id: 2, native_inline);

  // Inline linear acceleration vector.
  linear_acceleration: Vector3f (id: 3, native_inline);
}

root_type Imu;

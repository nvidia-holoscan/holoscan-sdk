include "tensor.fbs";

namespace prepared_schema_test;

struct Calibration { scale: float; revision: uint; }
table Child { label: string (id: 0); }
table Metadata {
  label: string (id: 0);
  tags: [string] (id: 1);
  calibration: Calibration (id: 2);
  child: Child (id: 3);
}
table Packet {
  sequence: ulong (id: 0);
  label: string (id: 1);
  readings: [float] (id: 2);
  tags: [string] (id: 3);
  metadata: Metadata (id: 4);
  calibration: Calibration (id: 5);
  first: holoscan.schema.Tensor (id: 6);
  second: holoscan.schema.Tensor (id: 7);
}
root_type Packet;
file_identifier "PRPD";

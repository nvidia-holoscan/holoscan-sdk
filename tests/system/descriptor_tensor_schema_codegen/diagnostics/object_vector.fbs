include "tensor.fbs";

namespace app3p;

table NestedValue {
  value: uint (id: 0);
}

table ObjectVector {
  tensor: holoscan.schema.Tensor (id: 0);
  nested: [NestedValue] (id: 1);
}

root_type ObjectVector;
file_identifier "DOV1";

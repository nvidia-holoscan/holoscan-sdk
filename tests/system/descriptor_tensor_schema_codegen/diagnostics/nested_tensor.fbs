include "tensor.fbs";

namespace app3p;

table NestedTensorValue {
  tensor: holoscan.schema.Tensor (id: 0);
}

table NestedTensorDescriptor {
  direct_tensor: holoscan.schema.Tensor (id: 0);
  nested: NestedTensorValue (id: 1);
}

root_type NestedTensorDescriptor;
file_identifier "DNT1";

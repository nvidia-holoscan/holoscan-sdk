# Used as an initial cache by isolated consumers and as settings by the CTest driver.
# Bracket arguments preserve spaces, semicolons, and literal variable references in parent flags.
set(SDK_SOURCE [==[@holoscan_SOURCE_DIR@]==])
set(SDK_BINARY [==[@holoscan_BINARY_DIR@]==])
set(SDK_ROOT [==[@CMAKE_CURRENT_BINARY_DIR@/operator_testing_installed/$<CONFIG>]==])
set(SDK_CONFIG [==[$<CONFIG>]==])
set(SDK_GENERATOR [==[@CMAKE_GENERATOR@]==])
set(SDK_GENERATOR_PLATFORM [==[@CMAKE_GENERATOR_PLATFORM@]==])
set(SDK_GENERATOR_TOOLSET [==[@CMAKE_GENERATOR_TOOLSET@]==])
set(SDK_CTEST_COMMAND [==[@CMAKE_CTEST_COMMAND@]==])
set(SDK_LIB_DIR [==[@HOLOSCAN_INSTALL_LIB_DIR@]==])
set(SDK_INCLUDE_DIR [==[@CMAKE_INSTALL_INCLUDEDIR@]==])
set(SDK_BIN_DIR [==[@CMAKE_INSTALL_BINDIR@]==])
set(SDK_EXAMPLES_DIR [==[@operator_testing_examples_install_dir@]==])
set(SDK_TESTING_ENABLED [==[@HOLOSCAN_BUILD_TESTING_LIBRARY@]==])
set(SDK_SHARED [==[@BUILD_SHARED_LIBS@]==])
set(GTEST_SOURCE [==[@CPM_PACKAGE_googletest_SOURCE_DIR@]==])
set(SDK_TOOLCHAIN_FILE [==[@CMAKE_TOOLCHAIN_FILE@]==])
if(NOT SDK_TOOLCHAIN_FILE STREQUAL "")
    set(CMAKE_TOOLCHAIN_FILE "${SDK_TOOLCHAIN_FILE}" CACHE FILEPATH "")
elseif(NOT SDK_GENERATOR MATCHES "^Visual Studio")
    set(CMAKE_C_COMPILER [==[@CMAKE_C_COMPILER@]==] CACHE FILEPATH "")
    set(CMAKE_CXX_COMPILER [==[@CMAKE_CXX_COMPILER@]==] CACHE FILEPATH "")
    set(CMAKE_CUDA_COMPILER [==[@CMAKE_CUDA_COMPILER@]==] CACHE FILEPATH "")
endif()
if(NOT [==[@CMAKE_MAKE_PROGRAM@]==] STREQUAL "")
    set(CMAKE_MAKE_PROGRAM [==[@CMAKE_MAKE_PROGRAM@]==] CACHE FILEPATH "")
endif()
set(CMAKE_CUDA_ARCHITECTURES [==[@CMAKE_CUDA_ARCHITECTURES@]==] CACHE STRING "")
if(NOT [==[@CMAKE_CUDA_HOST_COMPILER@]==] STREQUAL "")
    set(CMAKE_CUDA_HOST_COMPILER [==[@CMAKE_CUDA_HOST_COMPILER@]==] CACHE FILEPATH "")
endif()
set(CUDAToolkit_ROOT [==[@CUDAToolkit_LIBRARY_ROOT@]==] CACHE PATH "")
if(NOT [==[@CMAKE_MSVC_RUNTIME_LIBRARY@]==] STREQUAL "")
    set(CMAKE_MSVC_RUNTIME_LIBRARY [==[@CMAKE_MSVC_RUNTIME_LIBRARY@]==] CACHE STRING "")
endif()
set(CMAKE_BUILD_TYPE [==[$<CONFIG>]==] CACHE STRING "")
if(NOT [==[@CMAKE_CONFIGURATION_TYPES@]==] STREQUAL "")
    set(CMAKE_CONFIGURATION_TYPES [==[@CMAKE_CONFIGURATION_TYPES@]==] CACHE STRING "")
endif()
if(NOT [==[@CMAKE_CROSSCOMPILING_EMULATOR@]==] STREQUAL "")
    set(CMAKE_CROSSCOMPILING_EMULATOR [==[@CMAKE_CROSSCOMPILING_EMULATOR@]==] CACHE STRING "")
endif()
@operator_testing_consumer_flags@
# The SDK uses directory options for ASAN, which are not exported with its targets.
# Supply the same instrumentation to independent executables and provider libraries.
if(@HOLOSCAN_ENABLE_GOOGLE_SANITIZER@)
    set(sanitizer_compile_flags "-g -O1 -fsanitize=address -fno-omit-frame-pointer")
    if([==[@CMAKE_CXX_COMPILER_ID@]==] STREQUAL "GNU")
        string(APPEND sanitizer_compile_flags " -Wno-stringop-truncation")
    endif()
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${sanitizer_compile_flags}" CACHE STRING "" FORCE)
    # Config flags follow common flags in compiler commands. Keep ASAN's -O1/frame pointers last.
    set(sanitizer_configs ${CMAKE_CONFIGURATION_TYPES} "${SDK_CONFIG}")
    list(REMOVE_DUPLICATES sanitizer_configs)
    foreach(config IN LISTS sanitizer_configs)
        if(NOT config STREQUAL "")
            string(TOUPPER "${config}" config)
            set(CMAKE_CXX_FLAGS_${config}
                "${CMAKE_CXX_FLAGS_${config}} ${sanitizer_compile_flags}" CACHE STRING "" FORCE)
        endif()
    endforeach()
    foreach(link_kind IN ITEMS EXE SHARED MODULE)
        set(CMAKE_${link_kind}_LINKER_FLAGS "${CMAKE_${link_kind}_LINKER_FLAGS} -fsanitize=address"
            CACHE STRING "" FORCE)
    endforeach()
endif()

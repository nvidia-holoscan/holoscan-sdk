namespace holoscan.tests.channel;

// Test-only application schema used to validate custom FlatBuffer schema traits.
table CustomControl {
  // Monotonic control sequence.
  sequence: ulong (id: 0);

  // Small scalar control gain.
  gain: float (id: 1);

  // User-defined label.
  label: string (id: 2);
}

root_type CustomControl;

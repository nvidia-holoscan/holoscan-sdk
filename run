build_docs_desc() { c_echo 'Build and validate the Fern user guide

Runs the repository documentation pipeline from the current checkout. Any
remaining arguments are passed to docs/scripts/build_holoscan_docs.py.
With no arguments and no FERN_TOKEN, generated library MDX is skipped; when no
local API tree exists, validation omits the API-reference section.

Examples:
  ./public/run build_docs
  ./run build_docs                 # public repository layout
  ./public/run build_docs --skip-library-mdx
'
}
build_docs() {
    local docs_args=("$@")
    if [[ $# -eq 0 && -z "${FERN_TOKEN:-}" ]]; then
        docs_args=(--skip-library-mdx)
    fi
    run_command "${HOLOSCAN_PY_EXE}" \
        "${TOP}/docs/scripts/build_holoscan_docs.py" "${docs_args[@]}"
}

live_docs_desc() { c_echo 'Start a foreground local Fern user-guide preview

Runs the same documentation pipeline with --preview. Any remaining arguments
are passed to docs/scripts/build_holoscan_docs.py after --preview.
With no arguments and no FERN_TOKEN, the local preview omits the API-reference
section when no generated library MDX exists.

Examples:
  ./public/run live_docs
  ./run live_docs                   # public repository layout
  ./public/run live_docs --skip-library-mdx
'
}
live_docs() {
    local docs_args=(--preview "$@")
    if [[ $# -eq 0 && -z "${FERN_TOKEN:-}" ]]; then
        docs_args+=(--skip-library-mdx)
    fi
    build_docs "${docs_args[@]}"
}

#===============================================================================
# Section: Test
#===============================================================================

lint_desc() { c_echo 'Lint the repository (via pre-commit)

Runs all ordinary pre-commit hooks on the whole repo, including copyright,
formatting, lint, header guard, and ABI/export policy checks. Hooks assigned to
the manual stage run only when explicitly requested. Configuration is in
.pre-commit-config.yaml at repo root.

pre-commit is resolved automatically:
  1. uvx pre-commit  -- if uvx (from uv) is available (isolated, no pip pollution)
  2. pre-commit      -- if already installed
  3. pip install      -- as a last resort

Arguments:
  When no arguments are given, runs all hooks with --all-files.
  When arguments are given, they are passed directly to pre-commit run.

Examples:
  ./run lint                                    # all hooks, all files
  ./run lint update-notice-files --all-files    # single hook, all files
  ./run lint ruff-check --all-files             # single hook, all files
  ./run lint check-design-requirements-manifest --hook-stage manual --all-files
'
}
lint() {
    local REPO_ROOT
    # Prefer git toplevel when available; otherwise TOP (source archive / zip extract).
    if is_git_repo; then
        REPO_ROOT="$(git -C "${TOP}" rev-parse --show-toplevel)"
    else
        REPO_ROOT="${TOP}"
    fi
    if [ ! -f "${REPO_ROOT}/.pre-commit-config.yaml" ]; then
        c_echo_err R "Not found: ${REPO_ROOT}/.pre-commit-config.yaml"
        return 1
    fi
    local pre_commit_cmd
    if command -v uvx &>/dev/null; then
        pre_commit_cmd="uvx pre-commit"
    else
        if ! command -v pre-commit &>/dev/null; then
            c_echo W "Neither pre-commit nor uvx available, installing pre-commit via pip..."
            run_command ${HOLOSCAN_PY_EXE} -m pip install pre-commit
        fi
        pre_commit_cmd="pre-commit"
    fi
    c_echo W "Running pre-commit (copyright + lint hooks) on all files"
    if [ $# -gt 0 ]; then
        (cd "${REPO_ROOT}" && run_command ${pre_commit_cmd} run "$@")
    else
        (cd "${REPO_ROOT}" && run_command ${pre_commit_cmd} run --all-files)
    fi
}

test_desc() { c_echo 'Execute test cases with CTest

This command will run the tests using CTest. It will run headless
if no DISPLAY is found.

Arguments:

  --name, -n <regex>        Name of test(s) to execute (regular expression)
                            Default: all tests
  --verbose, -v             Print the test outputs
  --timeout, -t <seconds>   CTest timeout in seconds
                            Default: 480
  --options, -o <opts>      Extra flags to pass to CTest
                            Default: None
'
}
test() {
    local test_regex_flag=""
    local verbose=""
    local timeout=480
    local options=""

    # Parse CLI arguments next
    local extra_args=()
    while [[ $# -gt 0 ]]; do
    case $1 in
        --name|-n)
            local test_regex="$2"
            local test_regex_uppercase="${test_regex^^}"
            test_regex_flag="-R '$test_regex|$test_regex_uppercase'"
            shift
            shift
        ;;
        --verbose|-v)
            verbose="--verbose"
            shift
        ;;
        --timeout|-t)
            timeout="$2"
            shift
            shift
        ;;
        --options|-o)
            options="$2"
            shift
            shift
        ;;
        --no-xvfb)
            local no_xvfb="true"
            shift
        ;;
        *)
            extra_args+=("$1")
            shift
        ;;
    esac
    done

    # Workaround for a bug of the 550 driver where TLS resources are not released and the Vulkan
    # driver fails to initialize after a certain number of calls to vkCreateInstance.
    local preload=""
    if checkif_aarch64; then
        local driver_version=$(get_driver_version)
        local driver_major_version=$(echo "$driver_version" | cut -d'.' -f1)
        if [ "$driver_major_version" = 550 ]; then
            local candidate="/usr/lib/aarch64-linux-gnu/libnvidia-tls.so.${driver_version}"
            if [ -e "$candidate" ]; then
                preload="LD_PRELOAD=$candidate"
            fi
        fi
    fi

    # --init
    #   Use tini as entrypoint to forward proper signals to xvfb (below)
    #
    # --cap-drop=NET_BIND_SERVICE
    #   needed for SYSTEM_TEST that depends on privileged ports being unbindable
    #
    # $run_headless (xvfb-run -a)
    #   creates a display buffer for Holoviz use, the `-a` flag automatically finds
    #   an open display port, and sets the DISPLAY env var. This is installed inside
    #   the container at runtime so it isn't installed in the public container.
    #   Additionally, `xvfb-run -a docker run ...` is not used, as no solution was found
    #   that could reliably set the `-e DISPLAY` parameter using this approach.
    #
    if [ -z ${no_xvfb-} ]; then
        local run_headless=$([ -z ${DISPLAY-} ] && echo "xvfb-run -a")
    else
        local run_headless=""
    fi

    local build_dir="$(get_build_dir)"
    local ctest_file="${TOP}/${build_dir}/CTestTestfile.cmake"
    if [[ "${options}" != *"-S "* && -f "${TOP}/${build_dir}/CMakeCache.txt" && ! -f "${ctest_file}" ]]; then
        c_echo W "No CTest tests are registered in ${build_dir}; skipping test execution."
        return 0
    fi

    # Run ctest and capture output while also displaying it in real-time
    local ctest_output
    local ctest_exit_code

    # Use a temporary file to capture output while still displaying it
    local temp_output=$(mktemp)

    # Run ctest and tee output to both console and temp file
    launch "${build_dir}" \
        --init \
        --cap-drop=NET_BIND_SERVICE \
        "${extra_args[@]}" \
        --run-cmd "$preload $run_headless ctest . $test_regex_flag --timeout $timeout --output-on-failure $verbose $options" 2>&1 | tee "$temp_output"

    ctest_exit_code=${PIPESTATUS[0]}
    ctest_output=$(cat "$temp_output")
    rm -f "$temp_output"

    # Check if ctest output contains "No tests were found"
    if echo "$ctest_output" | grep -q "No tests were found"; then
        c_echo_err R "Error: No tests were found!"
        return 1
    fi

    # Return the original ctest exit code
    return $ctest_exit_code
}

#===============================================================================
# Section: Benchmark
#===============================================================================

bench_desc() { c_echo 'List, build, or execute benchmark cases

This command discovers CTest entries labeled "benchmark", then runs the matching
benchmark binaries directly inside the build container so Google Benchmark output
is not prefixed by CTest. If benchmark tests are not registered yet, it can
reconfigure and build benchmark targets automatically.

Arguments:

  --list                    List registered benchmark cases instead of running them
  --name, -n <regex>        Name of benchmark(s) to execute. Accepts aliases,
                            full CTest names, regex, and wildcards like core_*.
                            Can be repeated.
                            Default: all benchmarks
  --ctest                   Run through CTest instead of executing benchmark binaries directly
  --verbose, -v             Print verbose CTest output in --ctest mode
  --quiet                   Suppress verbose CTest output in --ctest mode
  --type <type>             Benchmark build type: release, rel-debug, or debug
                            Default: release
  --timeout, -t <seconds>   CTest timeout in seconds
                            Default: 480
  --options, -o <opts>      Extra flags to pass to CTest
                            Default: None
  --benchmark-args <args>   Extra Google Benchmark arguments appended to each benchmark
  --output-json <path>      Write Google Benchmark JSON output to a workspace-relative path
  --check-system            Report host CPU governor and ASLR benchmark-noise settings
  --stable-system           Temporarily set host CPU governors to performance and disable ASLR
                            while benchmarks run, then restore settings. Requires cached sudo.
  --rebuild                 Reconfigure and rebuild benchmark targets before running
  --no-build                Do not auto-build missing benchmark targets
  --no-xvfb                 Do not run through Xvfb when DISPLAY is unset

Examples:
  # Show registered benchmark aliases and their CTest names.
  ./run bench --list

  # Build missing benchmark targets and run all benchmarks.
  ./run bench

  # Run one benchmark by its friendly alias.
  ./run bench --name core_hello

  # Run benchmarks matching a shell-style wildcard.
  ./run bench --name core_*

  # Select multiple benchmarks by repeating --name.
  ./run bench --name core_hello --name BENCHMARK_CORE_HELLO

  # Run one benchmark by its full CTest name.
  ./run bench --name BENCHMARK_CORE_HELLO

  # Report host CPU governor and ASLR settings that can add benchmark noise.
  ./run bench --check-system

  # Temporarily reduce host-side benchmark noise while running one benchmark.
  ./run bench --stable-system --name core_hello

  # Run a longer repeated benchmark and report aggregate statistics only.
  ./run bench --stable-system --name core_hello \
    --benchmark-args "--benchmark_min_time=1s --benchmark_repetitions=10 --benchmark_report_aggregates_only=true"

  # Write Google Benchmark JSON output while keeping the terminal table visible.
  ./run bench --output-json benchmark.json
'
}
print_benchmark_list_guidance() {
    local ctest_output="$1"
    local found=false

    echo
    c_echo B "Available benchmark aliases"
    while IFS= read -r line; do
        if [[ "${line}" =~ Test[[:space:]]+#[0-9]+:[[:space:]]+([A-Za-z0-9_./:-]+) ]]; then
            local ctest_name="${BASH_REMATCH[1]}"
            local benchmark_alias="${ctest_name#BENCHMARK_}"
            benchmark_alias="${benchmark_alias,,}"
            found=true
            c_echo Y "  ${benchmark_alias}" W " (${ctest_name})"
            echo "    Run:  ./run bench --name ${benchmark_alias}"
            echo "    JSON: ./run bench --name ${benchmark_alias} --output-json benchmark-${benchmark_alias}.json"
        fi
    done <<< "${ctest_output}"

    if [ "${found}" != true ]; then
        c_echo W "  No benchmark aliases found in CTest output."
        return 1
    fi
}
benchmark_filter_to_regex() {
    local filter="$1"
    local glob_regex=""
    local i

    for ((i = 0; i < ${#filter}; i++)); do
        local char="${filter:i:1}"
        case "${char}" in
            '*')
                glob_regex+=".*"
            ;;
            '?')
                glob_regex+="."
            ;;
            '.'|'+'|'^'|'$'|'('|')'|'{'|'}'|'|'|'['|']'|'\\')
                glob_regex+="\\${char}"
            ;;
            *)
                glob_regex+="${char}"
            ;;
        esac
    done

    if [ "${glob_regex}" = "${filter}" ]; then
        echo -n "${filter}|${filter^^}"
    else
        echo -n "${filter}|${filter^^}|${glob_regex}|${glob_regex^^}"
    fi
}
build_benchmark_name_regex() {
    local regex_parts=()

    for filter in "$@"; do
        if [ -z "${filter}" ] || [ "${filter}" = "*" ] || [ "${filter,,}" = "all" ]; then
            echo -n ""
            return 0
        fi
        regex_parts+=("$(benchmark_filter_to_regex "${filter}")")
    done

    local IFS="|"
    echo -n "${regex_parts[*]}"
}
benchmark_check_system() {
    c_echo B "Benchmark host stability checks"

    if [ -r /proc/sys/kernel/randomize_va_space ]; then
        local aslr_value
        aslr_value="$(cat /proc/sys/kernel/randomize_va_space)"
        if [ "${aslr_value}" = "0" ]; then
            c_echo G "  ASLR: disabled (kernel.randomize_va_space=0)"
        else
            c_echo Y "  ASLR: enabled (kernel.randomize_va_space=${aslr_value})"
            echo "        For lower-noise benchmarks, run with --stable-system or temporarily set:"
            echo "        sudo sysctl kernel.randomize_va_space=0"
        fi
    else
        c_echo Y "  ASLR: unable to read /proc/sys/kernel/randomize_va_space"
    fi

    local governors=()
    local governor_file
    for governor_file in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -e "${governor_file}" ] || continue
        governors+=("$(cat "${governor_file}")")
    done

    if [ ${#governors[@]} -eq 0 ]; then
        c_echo Y "  CPU governor: unavailable on this host"
        return 0
    fi

    local unique_governors
    unique_governors="$(printf "%s\n" "${governors[@]}" | sort -u | tr '\n' ' ')"
    if [ "${unique_governors}" = "performance " ]; then
        c_echo G "  CPU governor: performance"
    else
        c_echo Y "  CPU governor(s): ${unique_governors}"
        echo "        For lower-noise benchmarks, run with --stable-system or temporarily set governors to performance."
    fi
}
benchmark_restore_stable_system() {
    local state_file="${1:-}"
    [ -n "${state_file}" ] && [ -f "${state_file}" ] || return 0

    local kind path value
    while IFS=$'\t' read -r kind path value; do
        case "${kind}" in
            ASLR)
                sudo -n sysctl -w "kernel.randomize_va_space=${value}" >/dev/null || true
            ;;
            GOVERNOR)
                if [ -e "${path}" ]; then
                    echo "${value}" | sudo -n tee "${path}" >/dev/null || true
                fi
            ;;
        esac
    done < "${state_file}"
    rm -f "${state_file}"
    c_echo W "Restored host benchmark stability settings."
}
benchmark_apply_stable_system() {
    local state_file="$1"

    if ! sudo -n true 2>/dev/null; then
        c_echo_err R "--stable-system requires cached sudo credentials."
        c_echo_err W "Run 'sudo -v' on the host, then retry ./run bench --stable-system ..."
        return 1
    fi

    if [ -r /proc/sys/kernel/randomize_va_space ]; then
        local aslr_value
        aslr_value="$(cat /proc/sys/kernel/randomize_va_space)"
        printf "ASLR\tkernel.randomize_va_space\t%s\n" "${aslr_value}" >> "${state_file}"
        if [ "${aslr_value}" != "0" ]; then
            sudo -n sysctl -w kernel.randomize_va_space=0 >/dev/null
        fi
    fi

    local governor_file
    for governor_file in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -e "${governor_file}" ] || continue
        local governor
        governor="$(cat "${governor_file}")"
        printf "GOVERNOR\t%s\t%s\n" "${governor_file}" "${governor}" >> "${state_file}"
        if [ "${governor}" != "performance" ]; then
            echo performance | sudo -n tee "${governor_file}" >/dev/null
        fi
    done

    c_echo W "Applied temporary host benchmark stability settings. They will be restored when this command exits."
}
bench() {
    local list_only=false
    local test_regex_flag=""
    local verbose="--verbose"
    local timeout=480
    local options=""
    local benchmark_args=""
    local output_json=""
    local rebuild=false
    local no_build=false
    local no_xvfb=""
    local use_ctest=false
    local check_system=false
    local stable_system=false
    local bench_build_type="$(get_buildtype_str release)"
    local name_filters=()
    local extra_args=()

    while [[ $# -gt 0 ]]; do
    case $1 in
        --list)
            list_only=true
            shift
        ;;
        --name|-n)
            name_filters+=("$2")
            shift
            shift
        ;;
        --verbose|-v)
            verbose="--verbose"
            shift
        ;;
        --ctest)
            use_ctest=true
            shift
        ;;
        --check-system)
            check_system=true
            shift
        ;;
        --stable-system)
            stable_system=true
            shift
        ;;
        --quiet)
            verbose=""
            shift
        ;;
        --type)
            bench_build_type="$(get_buildtype_str "$2")"
            rebuild=true
            shift
            shift
        ;;
        --timeout|-t)
            timeout="$2"
            shift
            shift
        ;;
        --options|-o)
            options="$2"
            shift
            shift
        ;;
        --benchmark-args)
            benchmark_args="$2"
            shift
            shift
        ;;
        --output-json)
            output_json="$2"
            shift
            shift
        ;;
        --rebuild)
            rebuild=true
            shift
        ;;
        --no-build)
            no_build=true
            shift
        ;;
        --no-xvfb)
            no_xvfb="--no-xvfb"
            shift
        ;;
        *)
            extra_args+=("$1")
            shift
        ;;
    esac
    done

    if [ "${check_system}" = true ]; then
        benchmark_check_system
        return 0
    fi

    if [ "${stable_system}" = true ]; then
        export BENCHMARK_STABLE_STATE_FILE="$(mktemp)"
        trap 'benchmark_restore_stable_system "${BENCHMARK_STABLE_STATE_FILE:-}"; unset BENCHMARK_STABLE_STATE_FILE' EXIT
        benchmark_apply_stable_system "${BENCHMARK_STABLE_STATE_FILE}"
        export HOLOSCAN_BENCHMARK_DISABLE_ASLR=1
        extra_args+=("-e" "HOLOSCAN_BENCHMARK_DISABLE_ASLR")
        extra_args+=("--security-opt" "seccomp=unconfined")
    fi

    local benchmark_name_regex
    benchmark_name_regex="$(build_benchmark_name_regex "${name_filters[@]}")"
    if [ -n "${benchmark_name_regex}" ]; then
        test_regex_flag="-R '${benchmark_name_regex}'"
        export HOLOSCAN_BENCHMARK_REGEX="${benchmark_name_regex}"
        extra_args+=("-e" "HOLOSCAN_BENCHMARK_REGEX")
    fi
    if [ "${list_only}" = true ]; then
        verbose=""
    fi

    local build_dir="$(get_build_dir)"
    local ctest_file="${TOP}/${build_dir}/CTestTestfile.cmake"
    local benchmark_ctest_dir="${TOP}/${build_dir}/benchmark"
    local benchmark_ctest_registered=false
    if [ -f "${ctest_file}" ] && [ -d "${benchmark_ctest_dir}" ] \
        && grep -Rqs "LABELS.*benchmark" "${benchmark_ctest_dir}"; then
        benchmark_ctest_registered=true
    fi

    local cmake_cache="${TOP}/${build_dir}/CMakeCache.txt"
    if [ -f "${cmake_cache}" ]; then
        local existing_build_type
        existing_build_type="$(grep -E '^CMAKE_BUILD_TYPE:STRING=' "${cmake_cache}" | cut -d= -f2 || true)"
        if [ -n "${existing_build_type}" ] && [ "${existing_build_type}" != "${bench_build_type}" ]; then
            if [ "${no_build}" = true ]; then
                c_echo_err R "Benchmark build type is ${existing_build_type}, but ${bench_build_type} is requested."
                c_echo_err W "Rebuild with: ./run bench --rebuild --type ${bench_build_type,,}"
                return 1
            fi
            c_echo W "Benchmark build type is ${existing_build_type}; reconfiguring as ${bench_build_type}."
            rebuild=true
        fi
    fi

    if [ "${rebuild}" = true ] || [ "${benchmark_ctest_registered}" != true ]; then
        if [ "${no_build}" = true ]; then
            c_echo_err R "No benchmark tests are registered in ${build_dir}."
            c_echo_err W "Rebuild with: ./run build --build-benchmarks true --reconfigure"
            return 1
        fi
        c_echo W "Benchmark tests are not registered; configuring and building benchmark targets."
        build \
            --build-benchmarks true \
            --build-python false \
            --sccache false \
            --type "${bench_build_type}" \
            --reconfigure \
            --config "-DHOLOSCAN_BUILD_EXAMPLES:BOOL=OFF" \
            --config "-DHOLOSCAN_BUILD_TESTS:BOOL=OFF"
    fi

    local benchmark_build_cmd="cmake --build . --target holoscan-benchmark-targets"
    if [ "${no_build}" = true ]; then
        benchmark_build_cmd=""
    fi

    if [ -n "${output_json}" ]; then
        case "${output_json}" in
            /*)
                c_echo_err R "--output-json must be a workspace-relative path: ${output_json}"
                return 1
            ;;
        esac
        local output_dir="${output_json%/*}"
        if [ "${output_dir}" != "${output_json}" ]; then
            mkdir -p "${TOP}/${output_dir}"
        fi
        benchmark_args="${benchmark_args} --benchmark_out=/workspace/holoscan-sdk/${output_json} --benchmark_out_format=json"
    fi

    if [ -n "${benchmark_args}" ]; then
        export HOLOSCAN_BENCHMARK_ARGS="${benchmark_args}"
        extra_args+=("-e" "HOLOSCAN_BENCHMARK_ARGS")
    fi

    local ctest_mode=""
    local direct_list_arg=""
    if [ "${list_only}" = true ]; then
        ctest_mode="-N"
        direct_list_arg="--list"
    fi

    local temp_output=$(mktemp)
    if [ "${use_ctest}" = true ]; then
        launch "${build_dir}" \
            --init \
            "${extra_args[@]}" \
            ${no_xvfb} \
            --run-cmd "${benchmark_build_cmd:+${benchmark_build_cmd} && }ctest . ${ctest_mode} -L benchmark ${test_regex_flag} --timeout ${timeout} --output-on-failure ${verbose} ${options}" 2>&1 | tee "$temp_output"
    else
        launch "${build_dir}" \
            --init \
            "${extra_args[@]}" \
            ${no_xvfb} \
            --run-cmd "${benchmark_build_cmd:+${benchmark_build_cmd} && }python3 /workspace/holoscan-sdk/benchmark/run_benchmark.py --run-ctest-benchmarks ${direct_list_arg}" 2>&1 | tee "$temp_output"
    fi

    local ctest_exit_code
    local ctest_output
    ctest_exit_code=${PIPESTATUS[0]}
    ctest_output=$(cat "$temp_output")
    rm -f "$temp_output"

    if echo "$ctest_output" | grep -q "No tests were found"; then
        c_echo_err R "Error: No benchmark tests were found!"
        return 1
    fi

    if [ "${use_ctest}" = true ] && [ "${list_only}" = true ]; then
        print_benchmark_list_guidance "${ctest_output}"
    fi

    if [ -n "${output_json}" ] && [ -f "${TOP}/${output_json}" ]; then
        c_echo G "Benchmark JSON written to ${output_json}"
    fi

    if [ "${stable_system}" = true ]; then
        benchmark_restore_stable_system "${BENCHMARK_STABLE_STATE_FILE:-}"
        trap - EXIT
        unset BENCHMARK_STABLE_STATE_FILE
    fi

    return $ctest_exit_code
}

#===============================================================================
# Section: Launch
#===============================================================================

launch_desc() { c_echo 'Launch the Holoscan build container

Note: any extraneous arguments not listed below will be added to `docker run`

Arguments:
    $1 - Working directory (e.g, "install" => "/workspace/holoscan-sdk/install")
         Default: build-<arch>
    --mount-point - Specifies the mount point (default is the directory of this script)
    --run-cmd - Specifies a command to run in the container instead of running interactively.
                This is the equivalent of what you would put after `bash -c` with `docker run`.
    --runtime - Selects the Docker runtime (default: nvidia).
    --ssh-x11 : [DEPRECATED] X11/Wayland forwarding is now auto-detected from DISPLAY/WAYLAND_DISPLAY
'
}
launch() {
    # Prerequisite steps
    if [ "$DO_STANDALONE" != "true" ]; then
        build_image
    fi

    local container_mount="/workspace/holoscan-sdk"
    local mount_point="${TOP}"
    local mount_device_opts=()
    local display_server_opts=()
    local display_xauth_file=""
    local extra_args=()
    local group_opts=()
    local run_cmd="bash"
    local docker_runtime="nvidia"
    local ssh_x11=0
    local tty_opts=()
    if [ -n "${USE_TTY}" ]; then
        tty_opts+=("${USE_TTY}")
    fi

    # An optional leading positional argument is the working directory; the remaining arguments are
    # passed to the docker command. Only consume the first argument when it is not a flag, otherwise
    # `launch --cpus=8` uses "--cpus=8" as the working directory name.
    local working_dir
    if [[ -n "${1-}" && "$1" != -* ]]; then
        working_dir="$1"
        shift
    else
        working_dir="$(get_build_dir)"
    fi

    # Parse CLI arguments next
    while [[ $# -gt 0 ]]; do
    case $1 in
        --mount-point)
            mount_point="$2"
            shift
            shift
        ;;
        --run-cmd)
            run_cmd="$2"
            shift
            shift
        ;;
        --runtime)
            if [[ $# -lt 2 || -z "$2" ]]; then
                fatal R "--runtime requires a value"
            fi
            docker_runtime="$2"
            shift
            shift
        ;;
        --runtime=*)
            docker_runtime="${1#--runtime=}"
            if [[ -z "$docker_runtime" ]]; then
                fatal R "--runtime requires a value"
            fi
            shift
        ;;
        --ssh-x11)
            c_echo_err Y "Warning: --ssh-x11 is deprecated and ignored; X11/Wayland forwarding now happens automatically when DISPLAY or WAYLAND_DISPLAY is set."
            ssh_x11=1
            shift
        ;;
        *)
            extra_args+=("$1")
            shift
        ;;
    esac
    done

    local host_mount_to_top=$(realpath --relative-to="$mount_point" "$TOP")
    local container_top="${container_mount}/${host_mount_to_top}"

    # Mount V4L2 device nodes
    for video_dev in $(find /dev -regex '/dev/video[0-9]+'); do
        mount_device_opts+=(--device "$video_dev")
    done

    # Mount Tegra's Video Input unit (capture data from CSI) device nodes
    for capture_dev in $(find /dev -regex '/dev/capture-vi-channel[0-9]+'); do
        mount_device_opts+=(--device "$capture_dev")
    done

    # Mount ConnectX device nodes
    if [ -e /dev/infiniband/rdma_cm ]; then
        mount_device_opts+=(--device /dev/infiniband/rdma_cm)
    fi
    for uverbs_dev in $(find /dev -regex '/dev/infiniband/uverbs[0-9]+'); do
        mount_device_opts+=(--device "$uverbs_dev")
    done

    # The device nodes under /dev/dri are owned by the root user and video and render groups,
    # so using a non-root user in the container requires to access these groups. Adding the group
    # names to `docker run --group-add` might not work as the group ids in the container and on the
    # host device might not match. Mounting `/etc/group` doesn't address it since the mount occurs
    # after the user and its groups are setup. Instead, we pass the group ids which we compute on
    # the host before starting the container.
    local video_id
    video_id=$(get_group_id video)
    if [ -n "$video_id" ]; then
        group_opts+=(--group-add "$video_id")
    fi
    local render_id
    render_id=$(get_group_id render)
    if [ -n "$render_id" ]; then
        group_opts+=(--group-add "$render_id")
    fi

    # Add docker group to enable DooD
    local docker_id
    docker_id=$(get_group_id docker)
    if [ -n "$docker_id" ]; then
        group_opts+=(--group-add "$docker_id")
    fi

    # Forward graphical applications when the host exposes a display.
    if [ -z "${DISPLAY-}" ] && [ -z "${WAYLAND_DISPLAY-}" ]; then
        info "No DISPLAY or WAYLAND_DISPLAY set; skipping display forwarding."
    else
        if [ -n "${XDG_SESSION_TYPE-}" ]; then
            display_server_opts+=(-e XDG_SESSION_TYPE)
        fi

        # Required by Vulkan, dconf, pipewire, etc. on both X11 and Wayland.
        if [ -n "${XDG_RUNTIME_DIR-}" ] && [ -d "${XDG_RUNTIME_DIR}" ]; then
            display_server_opts+=(-e XDG_RUNTIME_DIR)
            display_server_opts+=(-v "${XDG_RUNTIME_DIR}:${XDG_RUNTIME_DIR}")
        fi

        if [ -n "${WAYLAND_DISPLAY-}" ]; then
            display_server_opts+=(-e WAYLAND_DISPLAY)
        fi

        if [ -n "${DISPLAY-}" ]; then
            case "${DISPLAY}" in
                :*|unix:*|unix/:*)
                    if [ -d /tmp/.X11-unix ]; then
                        display_server_opts+=(-v /tmp/.X11-unix:/tmp/.X11-unix:ro)
                    fi
                    ;;
                *)
                    ;;
            esac
            display_server_opts+=(-e DISPLAY)

            # If the X server already accepts no-cookie connections (typically
            # SI:localuser peer-credential auth), skip the cookie setup. The
            # container runs as $(id -u) via -u, so the same auth family will
            # accept its socket connection.
            local peer_creds_sufficient=0
            if command -v xset >/dev/null \
                && XAUTHORITY=/dev/null timeout 2 xset -display "${DISPLAY}" q >/dev/null 2>&1; then
                peer_creds_sufficient=1
            fi
            if [ "${peer_creds_sufficient}" -eq 1 ]; then
                : # peer-creds is sufficient; no xauth setup needed
            elif ! command -v xauth >/dev/null; then
                c_echo_err Y "Warning: xauth not found on host; install xauth (or x11-xauth) so X11 applications can authenticate inside the container."
            else
                local xauth_entries=""
                if ! xauth_entries=$(xauth nlist "${DISPLAY}" 2>/dev/null) || [ -z "${xauth_entries}" ]; then
                    c_echo_err Y "Warning: xauth nlist returned no entries for DISPLAY=${DISPLAY}; X11 may not authenticate inside the container."
                else
                    local xauth_file=""
                    # umask 077 ensures the cookie file is created with mode 0600
                    # atomically; mktemp on POSIX already does this, but we set
                    # umask explicitly so the guarantee does not depend on the
                    # mktemp implementation.
                    xauth_file=$(umask 077 && mktemp "${TMPDIR:-/tmp}/.docker.xauth.XXXXXX")
                    if printf "%s\n" "${xauth_entries}" | sed -e 's/^..../ffff/' | xauth -f "${xauth_file}" nmerge - 2>/dev/null; then
                        display_xauth_file="${xauth_file}"
                        # Register cleanup so the cookie is removed even on SIGINT/SIGTERM/SIGHUP.
                        # shellcheck disable=SC2064
                        trap "rm -f '${display_xauth_file}'" EXIT INT TERM HUP
                        display_server_opts+=(-v "${display_xauth_file}:${display_xauth_file}:ro")
                        display_server_opts+=(-e "XAUTHORITY=${display_xauth_file}")
                    else
                        rm -f "${xauth_file}"
                        c_echo_err Y "Warning: xauth nmerge failed for DISPLAY=${DISPLAY}; X11 may not authenticate inside the container."
                    fi
                fi
            fi
        fi
    fi

    # DOCKER PARAMETERS
    #
    # --rm
    #   Deletes the container after the command runs
    #
    # --net=host
    #   Provide access to the host network
    #
    # --interactive (-i)
    #   The container needs to be interactive to be able to interact with the X11 windows
    #
    # ${USE_TTY}
    #   Set --tty when TTY is possible only
    #
    # --entrypoint=bash
    #   Override the default entrypoint to hide the regular message from the base image
    #
    # -u $(id -u):$(id -g)
    # -v /etc/group:/etc/group:ro
    # -v /etc/passwd:/etc/passwd:ro
    # ${group_opts[@]} (--group-add render; --group-add video)
    #   Run the container as a non-root user. See details above for `group_opts`.
    #
    # -v /var/run/docker.sock:/var/run/docker.sock
    #    Enable the use of Holoscan CLI with Docker outside of Docker (DooD) for packaging and
    #    running applications inside the container.
    #
    # -v ${TOP}:/workspace/holoscan-sdk
    #   Mount the source directory
    #
    # -w /workspace/holoscan-sdk/${working_dir}
    #   Start in the build or install directory
    #
    # --runtime=${docker_runtime} \
    #   Use the selected Docker runtime for this launch
    #
    # ${display_server_opts[@]}
    #   Enable graphical applications (X11 or Wayland)
    #
    # ${mount_device_opts[@]}
    #   --device /dev/video${i}
    #     Mount video capture devices for V4L2
    #
    #   --device /dev/capture-vi-channel${i}
    #     Mount Tegra's Video Input unit to capture from CSI
    #
    #   --device /dev/infiniband/...
    #     Mount ConnectX SmartNIC for MOFED
    #
    # -e PYTHONPATH
    # -e HOLOSCAN_LIB_PATH
    # -e HOLOSCAN_INPUT_PATH
    #   Define paths needed by the python applications
    #
    # -e CUPY_CACHE_DIR
    #   Define path for cupy' kernel cache, needed since $HOME does
    #   not exist when running with `-u id:group`
    #
    # --ipc=host
    # --cap-add=CAP_SYS_PTRACE
    #   Allow process tracing for debugging and profiling tools
    #
    # --cap-add=CAP_SYS_NICE
    # --ulimit rtprio=10
    #   Allow setting process priorities and scheduling policies for real-time scheduling
    #
    # --ulimit memlock=-1
    # --ulimit stack=67108864
    #   Set resource limits for memory locking (unlimited), stack size (64MB), to prevent
    #   out-of-memory issues on systems with high core counts.
    #
    # Container launch command steps:
    # - Append the Holoscan bin folder to the existing `PATH` before running
    # - Preserve the image-provided PYTHONPATH before running

    img="$(get_build_img_name):$(get_build_img_tag)"
    pythonpath=$("${HOLOSCAN_DOCKER_EXE}" inspect "${img}" --format '{{.Config.Env}}' | grep -oP 'PYTHONPATH=\K[^ ]+' || true)
    ld_library_path=$("${HOLOSCAN_DOCKER_EXE}" inspect "${img}" --format '{{.Config.Env}}' | grep -oP 'LD_LIBRARY_PATH=\K[^ ]+' || true)

    # JetPack 7.x uses the SBSA/dGPU CUDA stack, but nvidia-container-toolkit mounts some
    # host driver libraries under this platform-specific path.
    if [ -e /usr/lib/aarch64-linux-gnu/nvidia ]; then
        ld_library_path="/usr/lib/aarch64-linux-gnu/nvidia:${ld_library_path}"
    fi

    # If needed, create the build dir with user permissions
    if [ "${working_dir}" = "$(get_build_dir)" ]; then
        run_command mkdir -p "${TOP}/$(get_build_dir)"
    fi

    local launch_status=0
    run_command "${HOLOSCAN_DOCKER_EXE}" run \
        --rm \
        --net=host \
        --interactive \
        "${tty_opts[@]}" \
        --entrypoint=bash \
        -u "$(id -u):$(id -g)" \
        -v /etc/group:/etc/group:ro \
        -v /etc/passwd:/etc/passwd:ro \
        "${group_opts[@]}" \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "${mount_point}:${container_mount}" \
        -w "${container_top}/${working_dir}" \
        --runtime="${docker_runtime}" \
        "${display_server_opts[@]}" \
        "${mount_device_opts[@]}" \
        -e "LD_LIBRARY_PATH=${ld_library_path}" \
        -e "PYTHONPATH=${pythonpath}:${container_top}/${working_dir}/python/lib" \
        -e "HOLOSCAN_LIB_PATH=${container_top}/${working_dir}/lib" \
        -e "HOLOSCAN_INPUT_PATH=${container_top}/data" \
        -e "HOLOSCAN_TESTS_DATA_PATH=${container_top}/tests/data" \
        -e "CARGO_HOME=${container_top}/.cache/cargo" \
        -e "CUPY_CACHE_DIR=${container_top}/.cupy/kernel_cache" \
        --ipc=host \
        --cap-add=CAP_SYS_PTRACE \
        --cap-add=CAP_SYS_NICE \
        --ulimit rtprio=10 \
        --ulimit memlock=-1 \
        --ulimit stack=67108864 \
        "${extra_args[@]}" \
        "${img}" -c "
            export PATH=\"\$PATH:${container_top}/${working_dir}/bin\";
            $run_cmd" || launch_status=$?

    if [ -n "${display_xauth_file}" ]; then
        rm -f "${display_xauth_file}"
        trap - EXIT INT TERM HUP
    fi

    return ${launch_status}
}

#===============================================================================
# Logging utils
#===============================================================================

my_cat_prefix() {
    local IFS
    local prefix="$1"
    local line
    while IFS= read -r line; do
        echo "${prefix}${line}" # -e option doesn't work in 'sh' so disallow escaped characters
    done <&0
}

c_str() {
    local old_color=39
    local old_attr=0
    local color=39
    local attr=0
    local text=""
    local mode="color"
    if [ "${1:-}" = "color" ]; then
        mode="color"
        shift
    elif [ "${1:-}" = "nocolor" ]; then
        mode="nocolor"
        shift
    fi

    for i in "$@"; do
        case "$i" in
            r|R)
                color=31
                ;;
            g|G)
                color=32
                ;;
            y|Y)
                color=33
                ;;
            b|B)
                color=34
                ;;
            p|P)
                color=35
                ;;
            c|C)
                color=36
                ;;
            w|W)
                color=37
                ;;

            z|Z)
                color=0
                ;;
        esac
        case "$i" in
            l|L|R|G|Y|B|P|C|W)
                attr=1
                ;;
            n|N|r|g|y|b|p|c|w)
                attr=0
                ;;
            z|Z)
                attr=0
                ;;
            *)
                text="${text}$i"
        esac
        if [ "${mode}" = "color" ]; then
            if [ ${old_color} -ne ${color} ] || [ ${old_attr} -ne ${attr} ]; then
                text="${text}\033[${attr};${color}m"
                old_color=$color
                old_attr=$attr
            fi
        fi
    done
    /bin/echo -en "$text"
}

c_echo() {
    # Select color/nocolor based on the first argument
    local mode="color"
    if [ "${1:-}" = "color" ]; then
        mode="color"
        shift
    elif [ "${1:-}" = "nocolor" ]; then
        mode="nocolor"
        shift
    else
        if [ ! -t 1 ]; then
            mode="nocolor"
        fi
    fi

    local old_opt="$(shopt -op xtrace)" # save old xtrace option
    set +x # unset xtrace

    if [ "${mode}" = "color" ]; then
        local text="$(c_str color "$@")"
        /bin/echo -e "$text\033[0m"
    else
        local text="$(c_str nocolor "$@")"
        /bin/echo -e "$text"
    fi
    eval "${old_opt}" # restore old xtrace option
}

echo_err() {
    >&2 echo "$@"
}

c_echo_err() {
    >&2 c_echo "$@"
}

printf_err() {
    >&2 printf "$@"
}

get_unused_ports() {
    local num_of_ports=${1:-1}
    local start=${2:-49152}
    local end=${3:-61000}
    comm -23 \
    <(seq ${start} ${end} | sort) \
    <(ss -tan | awk '{print $4}' | while read line; do echo ${line##*\:}; done | grep '[0-9]\{1,5\}' | sort -u) \
    | shuf | tail -n ${num_of_ports} # use tail instead of head to avoid broken pipes in interactive terminals
}

newline() {
    echo
}

info() {
    c_echo_err W "$(date -u '+%Y-%m-%d %H:%M:%S') [INFO] " Z "$@"
}

error() {
    c_echo_err R "$(date -u '+%Y-%m-%d %H:%M:%S') [ERROR] " Z "$@"
}

fatal() {
    if [ -n "$*" ]; then
        c_echo_err R "$(date -u '+%Y-%m-%d %H:%M:%S') [FATAL] " Z "$@"
        echo_err
    fi
    if [ -z "${CALLER-}" ]; then
        return 1
    else
        kill -INT $$  # kill the current process instead of exit in shell environment.
    fi
}

#===============================================================================
# Driver functions
#===============================================================================

run_command() {
    local status=0
    local cmd="$*"

    if [ "${DO_DRY_RUN}" != "true" ]; then
        c_echo_err B "$(date -u '+%Y-%m-%d %H:%M:%S') " W "\$ " G "${cmd}"
    else
        c_echo_err B "$(date -u '+%Y-%m-%d %H:%M:%S') " C "[dryrun] " W "\$ " G "${cmd}"
    fi

    [ "$(echo -n "$@")" = "" ] && return 1 # return 1 if there is no command available

    if [ "${DO_DRY_RUN}" != "true" ]; then
        "$@"
        status=$?
    fi

    return $status
}

#######################################
# Get list of available commands from a given input file.
#
# Available commands and command summary are extracted by checking a pattern
# "_desc() { c_echo '".
# Section title is extracted by checking a pattern "# Section: ".
# This command is used for listing available commands in CLI.
#
# e.g.)
#   "# Section: String/IO functions"
#     => "# String/IO functions"
#   "to_lower_desc() { c_echo 'Convert to lower case"
#     => "to_lower ----------------- Convert to lower case"
#
# Arguments:
#   $1 - input file that defines commands
# Returns:
#   Print list of available commands from $1
#######################################
get_list_of_available_commands() {
    local mode="color"
    if [ "${1:-}" = "color" ]; then
        mode="color"
        shift
    elif [ "${1:-}" = "nocolor" ]; then
        mode="nocolor"
        shift
    fi

    local file_name="$1"
    if [ ! -e "$1" ]; then
        echo "$1 doesn't exist!"
    fi

    local line_str='--------------------------------'
    local IFS= cmd_lines="$(IFS= cat "$1" | grep -E -e "^(([[:alpha:]_[:digit:]]+)_desc\(\)|# Section: )" | sed "s/_desc() *{ *c_echo [\"']/ : /")"
    local line
    while IFS= read -r line; do
        local cmd=$(echo "$line" | cut -d":" -f1)
        local desc=$(echo "$line" | cut -d":" -f2-)
        if [ "$cmd" = "# Section" ]; then
            c_echo ${mode} B "${desc}"
        else
            # there is no substring operation in 'sh' so use 'cut'
            local dash_line="$(echo "${line_str}" | cut -c ${#cmd}-)"  #  = "${line_str:${#cmd}}"
             c_echo ${mode} Y "   ${cmd}" w " ${dash_line} ${desc}"
        fi
        # use <<EOF, not '<<<"$cmd_lines"' to be executable in sh
    done <<EOF
$cmd_lines
EOF
}

get_list_of_global_flags() {
    echo_err
    c_echo_err W "Global Arguments"
    echo_err "
    --help, -h                  : Print help messages for [command]
    --dryrun                    : Print commands to screen without running
    --standalone, -s            : Do not run prerequisite steps for build-related commands
    --no-cache, -n              : Do not use cache when building docker images
    --arch, -a [amd64 | arm64]  : Specify the platform (for cross-compilation)
        Default: current host architecture ($(get_host_arch))
        Associated environment variable: HOLOSCAN_BUILD_ARCH
    "
}

print_usage() {
    set +x
    echo_err
    echo_err "USAGE: $0 [command] [arguments]..."
    echo_err
    c_echo_err W "Command List"
    echo_err "$(get_list_of_available_commands color "${RUN_SCRIPT_FILE}" | my_cat_prefix " ")"
    echo_err
    echo_err "$(get_list_of_global_flags)"
}

print_cmd_help_messages() {
    local cmd="${1-}"
    if [ -n "${cmd}" ]; then
        if type ${cmd}_desc > /dev/null 2>&1; then
            ${cmd}_desc
            get_list_of_global_flags
            return 0
        else
            c_echo_err R "Command '${cmd}' doesn't exist!"
            print_usage
            return 1
        fi
    fi
    print_usage
}

main() {
    local ret=0

    # Parse command
    if [ -z "${1-}" ]; then
        print_usage
        return 0
    fi
    local cmd=$1
    shift
    if [ "${cmd}" = "-h" ] || [ "${cmd}" = "--help" ]; then
        print_usage
        return 0
    fi

    # Parse args
    local args=()
    unset ARCH
    while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            print_cmd_help_messages $cmd
            return 0
        ;;
        --dryrun|--dry-run)
            DO_DRY_RUN="true"
            shift
        ;;
        -s|--standalone)
            DO_STANDALONE="true"
            shift
        ;;
        -n|--no-cache)
            NO_CACHE="--no-cache"
            shift
        ;;
        -a|--arch)
            ARCH=$(get_gnu_arch_str $2)
            shift
            shift
        ;;
        *)
            args+=("$1")
            shift
        ;;
    esac
    done

    # Ensure arch is defined with a default if not passed explicitly.
    if [ -z "${ARCH-}" ]; then
        ARCH=$(get_gnu_arch_str ${HOLOSCAN_BUILD_ARCH:-$(get_host_arch)})
    fi

    # Run command
    case "$cmd" in
        ''|main|help)
            print_usage
            ;;
        *)
            if type ${cmd} > /dev/null 2>&1; then
                "$cmd" "${args[@]}"
            else
                c_echo_err R "Command '${cmd}' doesn't exist!"
                print_usage
                return 1
            fi
            ;;
    esac
    ret=$?
    if [ -z "${CALLER-}" ]; then
        return $ret
    fi
}

init_globals

if [ -z "${CALLER-}" ]; then
    main "$@"
fi

#===============================================================================
# Description template
#===============================================================================
# Globals:
#   HOLOSCAN_OS
#   HOLOSCAN_TARGET
#   HOLOSCAN_USER (used if HOLOSCAN_OS is "linux")
#   HOLOSCAN_HOST (used if HOLOSCAN_OS is "linux")
# Arguments:
#   Command line to execute
# Returns:
#   Outputs print messages during the execution (stdout->stdout, stderr->stderr).
#
#   Note:
#     This command removes "\r" characters from stdout.
#
#   Exit code:
#     exit code returned from executing a given command
